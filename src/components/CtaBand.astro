---
import Icon from './Icon.astro';
import { company } from '../data/site';
interface Props { title?: string; text?: string }
const {
  title = 'Masz ładunek do przewiezienia?',
  text = 'Opisz trasę, termin i rodzaj towaru. Przygotujemy przejrzystą i konkurencyjną wycenę.',
} = Astro.props;
---
<section class="cta-wrap">
  <div class="container">
    <div class="cta reveal">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="actions">
        <a class="btn btn--primary" href="/wycena-transportu/">Zamów wycenę <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href={`tel:${company.phoneHref}`}><Icon name="phone" /> {company.phone}</a>
      </div>
    </div>
  </div>
</section>
<style>
  .cta-wrap { padding-block: clamp(56px, 8vw, 96px); }
  .cta {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(32px, 5vw, 64px);
    border-radius: var(--radius-lg);
    background: var(--ink) url('/img/road-valley.webp') center / cover;
    color: rgb(255 255 255 / 0.8);
  }
  .cta::before { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(23 24 26 / 0.95), rgb(23 24 26 / 0.7)); }
  .cta > * { position: relative; }
  h2 { color: var(--white); margin-bottom: 10px; }
  p { max-width: 52ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
