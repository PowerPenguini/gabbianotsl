---
interface Props { eyebrow: string; title: string; text?: string; image: string; }
const { eyebrow, title, text, image } = Astro.props;
---
<section class="hero">
  <img class="bg" src={image} alt="" fetchpriority="high" />
  <div class="shade"></div>
  <div class="container inner">
    <span class="eyebrow">{eyebrow}</span>
    <h1 set:html={title} />
    {text && <p class="lead">{text}</p>}
    <div class="actions"><slot /></div>
  </div>
</section>
<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--ink);
    color: var(--white);
    padding: calc(80px + clamp(72px, 11vw, 140px)) 0 clamp(72px, 9vw, 120px);
    overflow: hidden;
  }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .shade {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(100deg, rgb(23 24 26 / 0.94) 0%, rgb(23 24 26 / 0.78) 45%, rgb(23 24 26 / 0.35) 100%);
  }
  .inner { display: grid; gap: 22px; justify-items: start; }
  h1 { color: var(--white); max-width: 18ch; font-size: clamp(2.2rem, 5vw, 3.8rem); }
  h1 :global(em) { font-style: normal; color: var(--orange); }
  .lead { color: rgb(255 255 255 / 0.78); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .actions:empty { display: none; }
</style>
