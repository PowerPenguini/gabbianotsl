---
import Base from '../layouts/Base.astro';
---
<Base title="Nie znaleziono strony" description="Strona nie istnieje.">
  <section class="section">
    <div class="container" style="text-align:center;display:grid;gap:20px;justify-items:center">
      <span class="eyebrow">Błąd 404</span>
      <h1>Ta trasa prowadzi donikąd</h1>
      <p class="lead">Strona, której szukasz, nie istnieje lub została przeniesiona.</p>
      <a class="btn btn--primary" href="/">Wróć na stronę główną</a>
    </div>
  </section>
</Base>
