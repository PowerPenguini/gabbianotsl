---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactDirect from '../components/ContactDirect.astro';
import { company } from '../data/site';

const reasons = [
  { icon: 'chart', title: 'Elastyczność na wymiar Twojego biznesu', text: 'Usługi skalowalne do specyfiki Twojego przedsiębiorstwa, pozwalające sprawnie reagować na zmieniające się potrzeby rynku.' },
  { icon: 'route', title: 'Stałe relacje na Twoich trasach', text: 'Możliwość ustanowienia stałych połączeń i tras daje stabilność i przewidywalność w planowaniu, a także oszczędność czasu.' },
  { icon: 'users', title: 'Stała opieka spedytorów', text: 'Dedykowany partner do rozwiązywania problemów logistycznych, gotowy szybko reagować i dostosowywać trasy do bieżących potrzeb.' },
  { icon: 'layers', title: 'Kompleksowość obsługi', text: 'Pełen zakres usług, od przygotowania pojazdów po organizację tras, abyś mógł skupić się na prowadzeniu biznesu.' },
  { icon: 'globe', title: 'Przygotowanie do ruchu międzynarodowego', text: 'Pomagamy w formalnościach i dostosowaniu pojazdów do wymogów przepisów międzynarodowych.' },
  { icon: 'card', title: 'Terminowe płatności', text: 'Przejrzyste zasady rozliczeń i uczciwe, terminowe płatności za każde zrealizowane zlecenie.' },
] as const;

---
<Base
  title="Dla przewoźnika"
  description="Dołącz do przewoźników współpracujących z GABBIANO TSL. Stałe zlecenia, terminowe płatności i całodobowa opieka spedytorów w całej Europie."
  transparentHeader
>
  <PageHero
    eyebrow="Dla przewoźnika"
    title="Dołącz do grona <em>zadowolonych</em> przewoźników"
    text="Całodobowa komunikacja, organizacja transportu na terenie całej Europy, przejrzyste zasady i pełne zrozumienie dla dynamicznego świata transportu drogowego."
    image={u('/img/highway.webp')}
  >
    <a class="btn btn--primary" href="#wspolpraca">Zapytaj o współpracę <Icon name="arrow" /></a>
    <a class="btn btn--ghost" href={`tel:${company.phoneHref}`}><Icon name="phone" /> {company.phone}</a>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Korzyści</span>
        <h2>Dlaczego warto z nami współpracować?</h2>
      </div>
      <div class="reasons">
        {reasons.map((r) => (
          <article class="reason reveal">
            <div class="r-icon"><Icon name={r.icon} /></div>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint" id="wspolpraca">
    <div class="container form-layout">
      <div class="aside reveal">
        <span class="eyebrow">Jesteś zainteresowany?</span>
        <h2>Zapytaj o współpracę</h2>
        <p class="lead">Zadzwoń lub napisz do nas. Nasz spedytor omówi z Tobą trasy i warunki współpracy.</p>
        <div class="media aside-img"><img src={u('/img/fleet-yard.webp')} alt="Ciągniki siodłowe na placu" loading="lazy" /></div>
      </div>
      <div class="reveal">
        <ContactDirect
          subject="Współpraca: przewoźnik"
          checklistTitle="Co warto podać na start"
          checklist={[
            'Nazwa firmy i NIP',
            'Transport krajowy czy międzynarodowy',
            'W jedną stronę czy pełne prowadzenie',
            'Typ pojazdu i zabudowa (np. firana, chłodnia, Mega)',
            'Liczba pojazdów',
            'Preferowane kierunki i baza',
          ]}
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .reasons { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .reason { padding: 32px; border: 1px solid var(--line); border-radius: var(--radius-lg); transition: box-shadow 0.2s ease, border-color 0.2s ease; }
  .reason:hover { box-shadow: var(--shadow); border-color: transparent; }
  .r-icon { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; background: var(--orange-50); color: var(--orange); margin-bottom: 22px; }
  .reason h3 { margin-bottom: 10px; }
  .reason p { color: var(--muted); }
  .form-layout { display: grid; gap: clamp(32px, 5vw, 64px); grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: center; }
  .aside { position: sticky; top: 112px; display: grid; gap: 18px; }
  .aside-img { margin-top: 12px; }
  @media (max-width: 960px) {
    .form-layout { grid-template-columns: 1fr; }
    .aside { position: static; }
    .aside-img { display: none; }
  }
</style>
