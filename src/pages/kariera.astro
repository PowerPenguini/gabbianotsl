---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactDirect from '../components/ContactDirect.astro';
import { company } from '../data/site';

const jobs = [
  { title: 'Praca w biurze', text: 'Spedycja, obsługa klienta i koordynacja przewozów w naszym biurze w Łodzi.', icon: 'users' },
  { title: 'Kierowca C+E', text: 'Transport krajowy i międzynarodowy nowoczesnymi zestawami.', icon: 'truck' },
  { title: 'Staż / Praktyki', text: 'Poznaj branżę TSL od środka i rozwijaj się pod okiem doświadczonego zespołu.', icon: 'route' },
] as const;
---
<Base
  title="Kariera"
  description="Dołącz do zespołu GABBIANO TSL. Szukamy pracowników biurowych, kierowców C+E oraz stażystów."
  transparentHeader
>
  <PageHero
    eyebrow="Kariera"
    title="Dołącz do zespołu <em>GABBIANO TSL</em>"
    text="Cenimy współpracę i zespołową atmosferę. Wierzymy, że efektywne działanie opiera się na wzajemnym wsparciu i zaufaniu."
    image={u('/img/driver.webp')}
  >
    <a class="btn btn--primary" href="#aplikuj">Aplikuj już dziś <Icon name="arrow" /></a>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Aktualne oferty</span>
        <h2>Kogo szukamy?</h2>
      </div>
      <div class="jobs">
        {jobs.map((j) => (
          <a class="job reveal" href={`mailto:${company.office}?subject=${encodeURIComponent(`Aplikacja: ${j.title}`)}`}>
            <div class="j-icon"><Icon name={j.icon} /></div>
            <div class="j-body">
              <h3>{j.title}</h3>
              <p>{j.text}</p>
            </div>
            <span class="link-arrow">Aplikuj <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint" id="aplikuj">
    <div class="container narrow">
      <div class="section-head section-head--center">
        <span class="eyebrow">Jak aplikować</span>
        <h2>Aplikuj już dziś!</h2>
        <p class="lead">Wyślij nam CV mailem lub zadzwoń. Skontaktujemy się z wybranymi kandydatami.</p>
      </div>
      <div class="reveal">
        <ContactDirect
          subject="Aplikacja: kariera"
          checklistTitle="W zgłoszeniu podaj"
          checklist={[
            'Stanowisko, na które aplikujesz',
            'Imię, nazwisko i telefon',
            'Możliwa data rozpoczęcia pracy',
            'Preferowany wymiar pracy',
            'Doświadczenie zawodowe',
            'Oczekiwane wynagrodzenie',
          ]}
        />
        <p class="cv-note">Pamiętaj, aby dołączyć CV do wiadomości.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .jobs { display: grid; gap: 16px; }
  .job {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
    padding: 28px 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .job:hover { border-color: var(--orange); box-shadow: var(--shadow); }
  .j-icon { width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center; background: var(--orange-50); color: var(--orange); }
  .j-body p { color: var(--muted); margin-top: 4px; }
  @media (max-width: 640px) {
    .job { grid-template-columns: 1fr; gap: 16px; padding: 24px; }
  }
  .narrow { max-width: 880px; }
  .cv-note { text-align: center; margin-top: 20px; color: var(--muted); font-size: 0.95rem; }
</style>
