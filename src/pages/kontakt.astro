---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactPeople from '../components/ContactPeople.astro';
import { company } from '../data/site';
---
<Base
  title="Kontakt"
  description="Skontaktuj się z GABBIANO TSL. Biuro: ul. Jana Kilińskiego 193/2.5, 93-126 Łódź. Telefon +48 42 278 75 74, e-mail office@g-tsl.com."
>
  <section class="section top">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Kontakt</span>
        <h1>Skontaktuj się z nami</h1>
        <p class="lead">Masz pytanie o wycenę, współpracę lub dostępność floty? Zadzwoń albo napisz, odpowiemy najszybciej, jak to możliwe.</p>
      </div>

      <div class="main">
        <a class="big big--phone reveal" href={`tel:${company.phoneHref}`}>
          <span class="b-icon"><Icon name="phone" size={28} /></span>
          <span class="b-label">Biuro</span>
          <span class="b-value">{company.phone}</span>
          <span class="b-cta">Zadzwoń <Icon name="arrow" size={18} /></span>
        </a>
        <a class="big reveal" href={`mailto:${company.office}`}>
          <span class="b-icon"><Icon name="mail" size={28} /></span>
          <span class="b-label">E-mail</span>
          <span class="b-value">{company.office}</span>
          <span class="b-cta">Napisz <Icon name="arrow" size={18} /></span>
        </a>
      </div>

      <div class="sub">
        <a class="small reveal" href={`mailto:${company.accounting}`}>
          <span class="s-icon"><Icon name="mail" /></span>
          <span><strong>Kadry i księgowość</strong>{company.accounting}</span>
        </a>
        <a class="small reveal" href={company.mapsUrl} target="_blank" rel="noopener">
          <span class="s-icon"><Icon name="pin" /></span>
          <span><strong>Adres biura</strong>{company.street}, {company.city}</span>
        </a>
      </div>
    </div>
  </section>

  <ContactPeople title="Porozmawiaj <em>bezpośrednio</em> z naszym zespołem" />

  <section class="section">
    <div class="container">
      <div class="map reveal">
        <iframe title="Mapa dojazdu do GABBIANO TSL" src={company.mapsEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Base>

<style>
  .top { padding-bottom: clamp(56px, 8vw, 96px); }
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .main { display: grid; gap: 20px; grid-template-columns: 1fr 1fr; }
  .big {
    display: grid; gap: 6px; align-content: start;
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--white);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    min-width: 0;
  }
  .big:hover { border-color: var(--orange); box-shadow: var(--shadow); transform: translateY(-2px); }
  .big--phone { background: var(--ink); border-color: var(--ink); }
  .big--phone .b-label { color: rgb(255 255 255 / 0.6); }
  .big--phone .b-value { color: var(--white); }
  .big--phone .b-icon { background: var(--orange); color: var(--white); }
  .big--phone .b-cta { color: var(--white); }
  .b-icon { width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center; background: var(--orange-50); color: var(--orange); margin-bottom: 18px; }
  .b-label { font-size: 0.8rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .b-value { font-size: clamp(1.5rem, 3.2vw, 2.3rem); font-weight: 800; color: var(--ink); letter-spacing: -0.02em; overflow-wrap: anywhere; line-height: 1.2; }
  .b-cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; font-weight: 700; color: var(--ink); }
  .b-cta :global(svg) { color: var(--orange); }
  .sub { display: grid; gap: 16px; grid-template-columns: 1fr 1fr; margin-top: 16px; }
  .small { display: flex; gap: 16px; align-items: center; padding: 20px 24px; border: 1px solid var(--line); border-radius: var(--radius); transition: border-color 0.2s ease; min-width: 0; }
  .small:hover { border-color: var(--orange); }
  .small strong { display: block; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .small span:last-child { font-weight: 700; color: var(--ink); overflow-wrap: anywhere; }
  .s-icon { flex: none; width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; background: var(--orange-50); color: var(--orange); }
  .map { border-radius: var(--radius-lg); overflow: hidden; height: 420px; background: var(--surface); border: 1px solid var(--line); }
  .map iframe { width: 100%; height: 100%; border: 0; filter: grayscale(0.4); }
  @media (max-width: 760px) { .main, .sub { grid-template-columns: 1fr; } }
</style>
