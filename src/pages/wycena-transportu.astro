---
import Base from '../layouts/Base.astro';
import ContactDirect from '../components/ContactDirect.astro';

const steps = [
  { t: 'Zadzwoń lub napisz', d: 'Podaj trasę, termin i informacje o ładunku.' },
  { t: 'Otrzymaj wycenę', d: 'Przygotujemy przejrzystą i konkurencyjną ofertę.' },
  { t: 'Realizacja', d: 'Odbieramy i dostarczamy ładunek zgodnie z harmonogramem.' },
];
---
<Base
  title="Wycena transportu"
  description="Wycena transportu krajowego i międzynarodowego. Zadzwoń +48 42 278 75 74 lub napisz na office@g-tsl.com, a GABBIANO TSL przygotuje ofertę."
>
  <section class="section">
    <div class="container quote">
      <div class="aside reveal">
        <span class="eyebrow">Wycena transportu</span>
        <h1>Skorzystaj z szybkiej wyceny już dziś</h1>
        <p class="lead">Dostosujemy się do specyfiki Twojego ładunku, terminu i szczególnych wymagań. Proponujemy transparentne i konkurencyjne ceny, aby zapewnić doskonałą obsługę i pełną klarowność finansową.</p>
        <ol class="steps">
          {steps.map((s, i) => (
            <li><span class="n">{i + 1}</span><div><strong>{s.t}</strong><p>{s.d}</p></div></li>
          ))}
        </ol>
      </div>
      <div class="reveal">
        <ContactDirect
          subject="Wycena transportu"
          checklistTitle="Do wyceny potrzebujemy"
          checklist={[
            'Miejsce załadunku',
            'Miejsce rozładunku',
            'Data załadunku i rozładunku',
            'Rodzaj towaru, waga, liczba palet',
            'Wymagania (np. ADR, chłodnia, winda)',
            'Nazwa firmy i NIP',
          ]}
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .quote { display: grid; gap: clamp(32px, 5vw, 72px); grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr); align-items: center; }
  h1 { font-size: clamp(2.2rem, 4.6vw, 3.4rem); margin-bottom: 18px; }
  .steps { list-style: none; padding: 0; margin: 36px 0 0; display: grid; gap: 20px; }
  .steps li { display: flex; gap: 16px; align-items: flex-start; }
  .n { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--white); font-weight: 800; font-size: 0.9rem; }
  .steps strong { color: var(--ink); }
  .steps p { color: var(--muted); font-size: 0.95rem; }
  @media (max-width: 960px) { .quote { grid-template-columns: 1fr; } }
</style>
